# Repo-root ignores. Each package also has its own .gitignore.

# dependencies
node_modules/
.pnp
.pnp.*

# next.js
.next/
out/
build/

# testing
coverage/
test-results/
playwright-report/

# typescript
*.tsbuildinfo
next-env.d.ts

# env files
.env*

# keys and secrets - never commit these
*.pem
*.key

# sqlite data lives in a docker volume, not in the repo
sqlite/
*.sqlite
*.sqlite3

# misc
.DS_Store
npm-debug.log*
yarn-debug.log*
yarn-error.log*
jmeter.log
